{
  "name": "@a-identity/trust-mcp",
  "version": "0.4.2",
  "description": "Pay A-Identity for trust checks (is it safe to pay this address, is this AI agent real) in USDC on Algorand, as an MCP server or as commands. Holding only XLM on Stellar? `buy` exchanges it through SideShift into USDC on Algorand and spends it on checks at fixed prices, each price also its own spending cap.",
  "type": "module",
  "bin": {
    "a-identity-trust-mcp": "dist/index.js"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/server.test.js dist-test/wallet.test.js dist-test/bridge.test.js dist-test/buy.test.js",
    "prepublishOnly": "tsc"
  },
  "keywords": [
    "a-identity",
    "mcp",
    "model-context-protocol",
    "agent",
    "trust",
    "reputation",
    "erc-8004",
    "kya",
    "x402",
    "algorand",
    "usdc",
    "stellar",
    "xlm"
  ],
  "homepage": "https://a-identity.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getA-Identity/A-Identity.git",
    "directory": "trust-mcp"
  },
  "bugs": {
    "url": "https://github.com/getA-Identity/A-Identity/issues"
  },
  "author": "A-Identity",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@a-identity/trust-guard": "^0.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@stellar/stellar-base": "^15.0.0",
    "algosdk": "^3.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
