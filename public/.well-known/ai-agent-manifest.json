{
  "$schema": "https://a-identity.xyz/schemas/agent-manifest-0.2.json",
  "name": "A-Identity",
  "description": "The passport and wallet for the agentic economy. On-chain agent identity (ERC-8004), x402 micro-payments, MCP-native tool access, and USDC settlement, live today on Circle Arc, with multi-chain identity planned across Base, Arbitrum, Avalanche, OKX X Layer, Stellar and Solana.",
  "version": "0.2.0",
  "audience": ["ai-agent", "developer"],
  "status": "preview",
  "capabilities": {
    "identity": {
      "standard": "ERC-8004",
      "registries": ["identity", "reputation", "validation"],
      "chains": [
        { "id": "arc", "chainId": 5042002, "caip2": "eip155:5042002", "identity": "ERC-8004", "erc8004Native": true, "status": "live" },
        { "id": "base", "chainId": 8453, "caip2": "eip155:8453", "identity": "ERC-8004", "erc8004Native": true, "status": "planned" },
        { "id": "arbitrum", "chainId": 42161, "caip2": "eip155:42161", "identity": "ERC-8004", "erc8004Native": true, "status": "planned" },
        { "id": "avalanche", "chainId": 43114, "caip2": "eip155:43114", "identity": "ERC-8004", "erc8004Native": true, "status": "planned" },
        { "id": "xlayer", "chainId": 196, "caip2": "eip155:196", "identity": "ERC-8004", "erc8004Native": true, "note": "OKX.AI identity registry reads are live; payment rails still planned", "status": "planned" },
        { "id": "stellar", "caip2": "stellar:testnet", "identity": "Soroban registry + SEP-10", "erc8004Native": false, "note": "ERC-8004 passport bridged from EVM", "status": "planned" },
        { "id": "solana", "caip2": "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp", "identity": "Anchor registry program", "erc8004Native": false, "note": "ERC-8004 passport bridged from EVM", "status": "planned" }
      ],
      "multiChain": true
    },
    "payments": {
      "standard": "x402",
      "settlement": "USDC",
      "also_supported": ["USDT", "PYUSD", "EURC"],
      "rails": [
        { "id": "arc", "name": "Circle Arc (Testnet)", "chainId": 5042002, "role": "primary: gas in USDC, App Kit unified balance, Gateway", "x402": true, "unified_balance": true, "status": "live" },
        { "id": "base", "name": "Base", "chainId": 8453, "role": "EVM fallback", "x402": true, "status": "planned" },
        { "id": "arbitrum", "name": "Arbitrum One", "chainId": 42161, "role": "DeFi gateway", "x402": true, "status": "planned" },
        { "id": "avalanche", "name": "Avalanche C-Chain", "chainId": 43114, "role": "fast-finality EVM, native Circle USDC", "x402": true, "status": "planned" },
        { "id": "xlayer", "name": "OKX X Layer", "chainId": 196, "role": "OKX.AI marketplace rail", "x402": true, "status": "planned" },
        { "id": "stellar", "caip2": "stellar:testnet", "role": "USDC + EURC native (Circle), Soroban", "x402": true, "status": "planned" },
        { "id": "solana", "caip2": "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp", "role": "high-throughput SPL USDC settlement", "x402": true, "status": "planned" }
      ],
      "wallets": "circle-agent-wallets",
      "status": "planned"
    },
    "connectivity": {
      "standard": "model-context-protocol",
      "transport": ["stdio", "http"],
      "paid_tools": "x402-mcp",
      "status": "preview"
    },
    "reputation": {
      "model": "deterministic",
      "range": [0, 1000],
      "formula": "settlement(0-600) + validation(0-240) + tenure(0-160)",
      "source": "settled x402 actions and ERC-8004 feedback",
      "cross_chain": true,
      "status": "preview"
    }
  },
  "okx_ai_asp": {
    "status": "live",
    "marketplace": "OKX.AI",
    "type": "A2MCP",
    "agentId": "#6271",
    "network": "X Layer mainnet (eip155:196)",
    "settlement": "x402 pay-per-call in USD₮0",
    "positioning": "the identity & reputation oracle for the agent economy",
    "endpoint": "https://a-identity-asp.onrender.com",
    "proof": "https://a-identity-asp.onrender.com/proof",
    "methodology": "https://a-identity-asp.onrender.com/methodology",
    "paid_tools": [
      { "name": "verify_agent", "method": "POST /tools/verify_agent", "priceUsd": 0.001, "returns": "ERC-8004 identity + KYA status" },
      { "name": "reputation_score", "method": "POST /tools/reputation_score", "priceUsd": 0.002, "returns": "deterministic 0-1000 reputation" },
      { "name": "risk_check", "method": "POST /tools/risk_check", "priceUsd": 0.005, "returns": "pre-transaction ALLOW / WARN / DENY" },
      { "name": "agent_passport", "method": "POST /tools/agent_passport", "priceUsd": 0.01, "returns": "full identity + KYA + reputation + risk" }
    ],
    "realOnchainRevenue": { "settlements": 83, "network": "X Layer mainnet (eip155:196)", "asset": "USD₮0" }
  },
  "tools": [
    { "name": "resolve_agent", "kind": "read", "input": "query (CAIP-10 id, token id, address, domain)", "returns": "ERC-8004 identity (all chains)" },
    { "name": "get_reputation", "kind": "read", "input": "agentId (CAIP-10)", "returns": "deterministic score 0-1000 + breakdown" },
    { "name": "list_agents", "kind": "read", "input": "chain? (any registry chain id, e.g. arc|base|arbitrum|xlayer)", "returns": "registered agents on that chain or all" },
    { "name": "get_chain_status", "kind": "read", "input": "none", "returns": "every registry chain with its lifecycle status and agent counts" },
    { "name": "list_capabilities", "kind": "read", "input": "none", "returns": "full protocol manifest" }
  ],
  "interaction": {
    "agent_to_agent": {
      "flow": ["resolve_agent", "get_reputation", "negotiate", "pay_x402", "deliver"],
      "trust": "Both agents verify each other via ERC-8004 before value moves. Reputation gate (default: 300+).",
      "settlement": "x402 in stablecoins on Arc, the live chain today. Base, Arbitrum, Avalanche, OKX X Layer, Stellar and Solana are planned. No shared accounts or API keys.",
      "chains_supported": ["arc", "base", "arbitrum", "avalanche", "xlayer", "stellar", "solana"]
    },
    "agent_to_human": {
      "flow": ["agent_proposes", "human_reviews", "human_approves", "settle"],
      "trust": "An agent presents its passport; the human sets limits and grants scoped permission.",
      "constraint": "Payments above the auto-approve threshold pause for explicit human approval."
    },
    "permissions": {
      "model": "policy-scoped",
      "controls": ["daily_cap", "payee_allowlist", "auto_approve_under", "per_tx_cap", "reputation_gate", "freeze"],
      "default": "deny",
      "require_2of2": false
    }
  },
  "endpoints": {
    "mcp": "https://a-identity.xyz/mcp",
    "rest": {
      "agent": "https://a-identity.xyz/api/agent?q={query}",
      "reputation": "https://a-identity.xyz/api/reputation?id={agentId}",
      "chains": "https://a-identity.xyz/api/chains",
      "agents": "https://a-identity.xyz/api/agents?chain={chain}"
    },
    "manifest": "/.well-known/ai-agent-manifest.json",
    "docs": "https://a-identity.mintlify.site",
    "sdk": "https://a-identity.mintlify.site/developers/sdk"
  },
  "contact": "agents@a-identity.xyz",
  "human_oversight": "Actions that hold a key, deploy a contract, or move value require explicit human approval. A person stays in the tower; agents act inside the limits and policies the human sets. No autonomous key custody or mainnet contract deployment."
}
